# ═══════════════════════════════════════════════
# CareVo Health — Environment Variables
# Copy this file to .env and fill in real values.
# The application will refuse to start if any
# required variable is missing or invalid.
# ═══════════════════════════════════════════════

# --- Server ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/carevo?retryWrites=true&w=majority

# --- Redis ---
REDIS_URL=rediss://default:password@your-redis-host:6379

# --- JWT (min 64 characters each, must be different) ---
JWT_ACCESS_SECRET=replace-with-64-char-random-hex-string-for-access-token-signing-key-here!!
JWT_REFRESH_SECRET=replace-with-64-char-random-hex-string-for-refresh-token-signing-key-here!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Field-Level Encryption (64-char hex = 32 bytes for AES-256-GCM) ---
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Email (Resend) ---
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@carevo.health

# --- SMS & Payments (Moolre) ---
MOOLRE_API_USER=your-moolre-username
MOOLRE_API_KEY=your-moolre-api-key
MOOLRE_VASKEY=your-moolre-sms-vaskey

# --- Seed Admin ---
SEED_ADMIN_EMAIL=admin@carevo.health
SEED_ADMIN_PASSWORD=ChangeThisToAStrongPasswordImmediately!2024
